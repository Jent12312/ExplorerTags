<Window x:Class="ExplorerTagsUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка проекта" Height="450" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Text="Загрузка..." FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#CCCCCC"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#252526" Padding="5">
            <ListBox x:Name="LstIcons" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Width="460"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="80" Height="80" Margin="5" HorizontalAlignment="Center">
                            <Image Source="{Binding ImagePath}" Width="48" Height="48" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Выбор и управление тегами -->
        <StackPanel Grid.Row="2" Margin="0,15,0,15">
            <TextBlock Text="Выберите тег проекта:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" Foreground="#CCCCCC"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbTags" Height="30" FontSize="13" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="➕ Новый" Click="BtnNewTag_Click" Width="85" Height="30" Margin="8,0,0,0" Background="#333333" Foreground="White" BorderBrush="#555555"/>
                <Button Grid.Column="2" Content="🗑️ Удалить" Click="BtnDeleteTag_Click" Width="85" Height="30" Margin="5,0,0,0" Background="#333333" Foreground="#FF6B6B" BorderBrush="#555555"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Применить" Click="BtnApply_Click" Width="110" Height="32" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="Сбросить всё" Click="BtnReset_Click" Width="110" Height="32" Background="#D9534F" Foreground="White" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="90" Height="32" Background="#333333" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>